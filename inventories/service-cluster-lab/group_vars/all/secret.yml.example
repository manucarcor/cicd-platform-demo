# ============================================================================
# EJEMPLO de fichero de secretos (secret.yml) para este entorno.
#
# En el proyecto real este fichero NO se versiona en texto plano: se cifra
# con Ansible Vault y se referencia desde hosts.ini y group_vars/all/all.yml
# mediante variables "secret_*".
#
# Cómo generarlo:
#   1. Copia este fichero como "secret.yml" en el mismo directorio.
#   2. Rellena los valores reales.
#   3. Cífralo con:
#        ansible-vault encrypt secret.yml
#      (te pedirá una contraseña de vault; guárdala en un gestor de
#      contraseñas o en un fichero .vault_pass fuera del control de
#      versiones, nunca la subas al repositorio).
#   4. Ejecuta los playbooks pasando --ask-vault-pass o
#      --vault-password-file=.vault_pass
#
# Este repositorio de demo NUNCA incluye secret.yml real ni la contraseña
# de vault correspondiente.
# ============================================================================
---
# Acceso SSH/sudo a los nodos del clúster (hosts.ini)
secret_ansible_password: "CHANGEME"
secret_ansible_become_password: "CHANGEME"

# Credenciales del registry/repositorio Helm privado (Step01-requirements.yml,
# roles/common_tasks/templates/registry_auth.json.j2)
secret_helm_username: "CHANGEME"
secret_helm_password: "CHANGEME"
secret_registry_password: "CHANGEME"

# Contraseñas de administración de cada servicio desplegado
secret_jenkins_admin_password: "CHANGEME"
secret_gitlab_root_password: "CHANGEME"
secret_nexus_admin_password: "CHANGEME"

# Token de registro del GitLab Runner (roles/role_gitlab_runner)
secret_gitlab_runner_token: "CHANGEME"

# No usadas por ningún role/playbook de este repo a día de hoy (posibles
# restos de una versión anterior con Redis/Postgres externos para GitLab).
# Se documentan por completitud pero puedes omitirlas.
secret_gitlab_redis_password: "CHANGEME"
secret_gitlab_postgres_password: "CHANGEME"
